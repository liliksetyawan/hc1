PORT=8080

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hackethon
DB_SSLMODE=disable

WORKSHOP_QUOTA_TOTAL=30
REGISTRATION_VERIFICATION_TTL_SECONDS=60

# Verification emails are only sent if both SMTP_USERNAME and SMTP_PASSWORD
# are set — otherwise the server logs a warning at startup and regis_url is
# only returned in the API response, never emailed.
# SMTP_PASSWORD must be a Gmail App Password (myaccount.google.com/apppasswords),
# not your regular Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
